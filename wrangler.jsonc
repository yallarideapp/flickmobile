{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flickmobile",
  "main": "server/index.js",
  "compatibility_date": "2026-07-30",
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "directory": "./dist/live",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/ar",
      "/ar/*",
      "/en",
      "/en/*",
      "/admin",
      "/admin/*",
      "/robots.txt",
      "/sitemap.xml",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flickmobile",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "MEDIA", "id": "00000000000000000000000000000000" },
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 2 * * *"] },
  "vars": { "ENVIRONMENT": "local-preparation" },
}
